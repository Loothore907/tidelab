//@version=5
strategy("TideLab Synthetic Unsupported", overlay=false, pyramiding=0, process_orders_on_close=false, calc_on_every_tick=false, default_qty_type=strategy.percent_of_equity, default_qty_value=25)
entrySignal = close > ta.ema(close, 3)
exitSignal = close < ta.sma(close, 3)
if entrySignal
    strategy.entry("L", strategy.long)
if exitSignal
    strategy.close("L")
